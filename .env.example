# ---------- WHOOP ----------
# 從 https://developer-dashboard.whoop.com 建立 App 後取得
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# 一次性授權腳本用的 redirect uri，必須和 WHOOP App 後台填的「完全一樣」
WHOOP_REDIRECT_URI=http://localhost:8788/callback

# ---------- OpenRouter（AI 教練文字）----------
# 從 https://openrouter.ai/settings/keys 建立
OPENROUTER_API_KEY=
# model id 要帶 namespace，清單見 https://openrouter.ai/models
# 想更省可以改 anthropic/claude-haiku-4.5
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Turso (libSQL) ----------
# turso db show <name> --url  → libsql://xxx.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------- 其他 ----------
TIMEZONE=Asia/Taipei

# REPO_LAST_COMMIT_AT 不用填 —— 由 GitHub Actions workflow 自動注入，
# 用來提醒「repo 快滿 60 天沒 commit，排程要被停用了」。本機 / Render 沒有就自動跳過。

# 選填：本機測試用。設 1 時所有外部寫入(Telegram)只印在畫面上不真的發送
# DRY_RUN=1
