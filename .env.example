# ---------- WHOOP ----------
# 從 https://developer-dashboard.whoop.com 建立 App 後取得
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# 一次性授權腳本用的 redirect uri，必須和 WHOOP App 後台填的「完全一樣」
WHOOP_REDIRECT_URI=http://localhost:8788/callback

# ---------- Claude ----------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Turso (libSQL) ----------
# turso db show <name> --url  → libsql://xxx.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---------- 其他 ----------
TIMEZONE=Asia/Taipei

# 選填：本機測試用。設 1 時所有外部寫入(Telegram)只印在畫面上不真的發送
# DRY_RUN=1
